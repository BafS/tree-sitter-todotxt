{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "todotxt",
      "camelcase": "Todotxt",
      "title": "todo.txt",
      "scope": "text.todotxt",
      "file-types": ["todo.txt", "done.txt"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^todo(txt)?$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "todo.txt grammar for tree-sitter",
    "authors": [{ "name": "BafS" }]
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
